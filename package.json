{
	"private": true,
	"scripts": {
		"build": "parcel build",
		"lint": "run-p lint:*",
		"lint-fix": "run-p 'lint:* -- --fix'",
		"lint:css": "stylelint source/**/*.css",
		"lint:js": "xo",
		"prepare": "husky",
		"test": "run-s lint build test:unit test:ext",
		"test:ext": "web-ext lint --source-dir distribution",
		"test:unit": "vitest run",
		"watch": "parcel watch --no-hmr"
	},
	"browserslist": [
		"last 1 Chrome version",
		"last 1 Firefox version"
	],
	"xo": {
		"envs": [
			"browser",
			"webextensions"
		],
		"overrides": [
			{
				"files": [
					"test/**/*.js",
					"vitest.config.js"
				],
				"envs": [
					"node",
					"browser"
				]
			}
		],
		"rules": {
			"unicorn/prefer-top-level-await": "off"
		}
	},
	"stylelint": {
		"extends": [
			"stylelint-config-xo"
		],
		"rules": {}
	},
	"devDependencies": {
		"@parcel/config-webextension": "^2.12.1-canary.3290",
		"@parcel/resolver-default": "^2.0.0-canary.1735",
		"husky": "^9.1.7",
		"jsdom": "^26.0.0",
		"npm-run-all": "^4.1.5",
		"parcel": "^2.0.0-canary.1665",
		"stylelint": "^16.6.1",
		"stylelint-config-prettier": "^9.0.5",
		"stylelint-config-xo": "^1.0.2",
		"vitest": "^3.0.5",
		"web-ext": "^8.3.0",
		"xo": "^0.58.0"
	},
	"@parcel/resolver-default": {
		"packageExports": true
	},
	"targets": {
		"default": {
			"source": "source/manifest.json",
			"distDir": "./distribution"
		}
	},
	"webExt": {
		"sourceDir": "distribution",
		"run": {
			"startUrl": [
				"https://github.com/fregante/browser-extension-template"
			]
		}
	}
}
